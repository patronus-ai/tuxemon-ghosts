+        # Set up our networking for multiplayer. Headless clients pass
+        # start_networking=False: TuxemonServer binds a *fixed* port
+        # (40081/0.0.0.0) as a side effect of construction, and upstream's
+        # own NetworkManager.shutdown() never actually releases it (it
+        # never calls WebsocketServerWrapper.stop_listening()), so a
+        # second client built in the same process would either fail an
+        # unhandled bind in a background thread or, worse, report
+        # is_host() == True from a server that never actually bound --
+        # TuxemonServer.__init__ sets `listening = True` unconditionally
+        # regardless of whether the bind succeeded. Not starting the
+        # server at all for headless clients avoids both failure modes.
         self.network_manager = NetworkManager(self)
-        self.network_manager.initialize()
+        if start_networking:
+            self.network_manager.initialize()
 
