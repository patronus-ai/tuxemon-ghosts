+    def defer(self, action: EventAction) -> None:
+        """
+        Queue an action to be advanced by the client's fixed step.
+
+        Called by EventAction.run() once an action outlives its first
+        update() call, so it is advanced by update() -> _update_deferred()
+        on subsequent frames instead of spinning on a wall clock.
+        """
+        self._deferred.append(action)
+
+    def _update_deferred(self, dt: float) -> None:
+        """
+        Advance actions queued by defer(), on the client's fixed step.
+
+        Mirrors RunningEvent.process(): an action that finishes (done or
+        cancelled) this frame gets cleanup() called once, here, since
+        ActionContextManager.__exit__ skips cleanup() for an action that
+        was still running when EventAction.run() returned.
+
+        A failing update() is caught per-action rather than left to
+        propagate straight out of the for loop: self._deferred is only
+        reassigned after the loop, so an uncaught exception here would
+        leave the failing action (and every action still unprocessed
+        this frame) exactly where they were before this call, unremoved
+        -- the failing action would then retry, and re-raise, on every
+        subsequent frame, starving every other queued action behind it.
+        Instead, a failing action is dropped from the queue and its
+        cleanup() still runs, every other queued action still gets its
+        update() this frame, and the first failure seen this frame is
+        re-raised once, after the loop, matching the old spin loop's
+        raise-once-to-the-caller contract without the old code's
+        forever-clogged-queue failure mode.
+        """
+        still_running: list[EventAction] = []
+        first_error: Exception | None = None
+        for action in self._deferred:
+            if action.done or action.cancelled:
+                continue
+            try:
+                action.update(self.session, dt)
+            except Exception as e:
+                logger.error(f"Error updating deferred action: {e}")
+                if first_error is None:
+                    first_error = e
+                try:
+                    action.cleanup(self.session)
+                except Exception as cleanup_error:
+                    logger.error(
+                        "Error cleaning up deferred action after update "
+                        f"failure: {cleanup_error}"
+                    )
+                continue
+            if action.done or action.cancelled:
+                action.cleanup(self.session)
+            else:
+                still_running.append(action)
+        self._deferred = still_running
+        if first_error is not None:
+            raise first_error
+
