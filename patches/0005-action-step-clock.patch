+    def defer(self, action: EventAction) -> None:
+        """
+        Queue an action to be advanced by the client's fixed step.
+
+        Called by EventAction.run() once an action outlives its first
+        update() call, so it is advanced by update() -> _update_deferred()
+        on subsequent frames instead of spinning on a wall clock.
+        """
+        self._deferred.append(action)
